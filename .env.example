# Prefer npm run env:init to generate a random local password without overwriting existing files.
DATABASE_URL=postgresql://iresearch:replace-with-local-password@localhost:5432/iresearch?schema=public
POSTGRES_PASSWORD=replace-with-the-same-local-password
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=generate-a-unique-secret-with-npm-run-env-init
# Email, payments, private storage, and malware scanning are explicitly disabled.
# Do not add production secrets here. No production integration variables are active yet.
